# GameShelf Environment Configuration Example
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-super-secure-random-secret-key-32-chars

# PostgreSQL Database Configuration
POSTGRES_USER=gameshelf_user
POSTGRES_PASSWORD=gameshelf_secure_password_2026
POSTGRES_DB=gameshelf_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database connection URL (automatically used if provided, otherwise constructed from POSTGRES_* vars)
DATABASE_URL=postgresql://gameshelf_user:gameshelf_secure_password_2026@db:5432/gameshelf_db

# Default Admin Credentials for Auto-Seeding / CLI
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gameshelf.com
ADMIN_PASSWORD=Admin123!

